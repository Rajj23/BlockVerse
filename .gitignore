# ── Backend (Java / Maven / Spring Boot) ──────────────────────────────────────
backend/target/
backend/*.class
backend/*.jar
backend/*.war
backend/.mvn/wrapper/maven-wrapper.jar
backend/.idea/
backend/*.iml
backend/.env

# ── Frontend (Node / Next.js) ─────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/.env.local
frontend/.env.*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnp
frontend/.pnp.js
frontend/tsconfig.tsbuildinfo

# ── Root env & secrets ────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
id_ed25519*
id_rsa*
secrets/
credentials/
.aws/

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Docker ────────────────────────────────────────────────────────────────────
# Keep docker-compose.yml tracked, ignore override files
docker-compose.override.yml

# ── Terraform ─────────────────────────────────────────────────────────────────
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfvars
terraform/tfplan

# ── Secrets (never commit these) ──────────────────────────────────────────────
k8s/secrets.yaml
terraform/secrets.tf
k8s/monitoring/*secret*
k8s/monitoring/secrets.yaml

