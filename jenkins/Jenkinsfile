// BlockVerse CD Pipeline
// This runs AFTER GitHub Actions (CI) has already built and pushed images to ECR.
// Jenkins only does: pull latest image tag from ECR → deploy to k3s via kubectl.

pipeline {
    agent any

    environment {
        AWS_REGION             = "ap-south-1"
        // Fill in after: terraform output ecr_backend_url / ecr_frontend_url
        ECR_REGISTRY           = "313694531077.dkr.ecr.ap-south-1.amazonaws.com"
        // Fill in after: terraform output k3s_public_ip
        K3S_SERVER_IP          = "65.0.171.134"
        K3S_SSH_CREDENTIALS_ID = "k3s-ssh-key"   // Jenkins credential ID for SSH key
        K8S_NAMESPACE          = "blockverse"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    stages {

        stage('Get Image Tag') {
            steps {
                script {
                    // Use the git commit SHA as the image tag (same tag GitHub Actions used)
                    env.IMAGE_TAG = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    echo "Deploying image tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Deploy to k3s') {
            steps {
                script {
                    def REMOTE = "ubuntu@${env.K3S_SERVER_IP}"
                    def KUBECTL = "kubectl --kubeconfig=/home/ubuntu/.kube/config"
                    def BACKEND_IMAGE  = "${env.ECR_REGISTRY}/blockverse-backend:${env.IMAGE_TAG}"
                    def FRONTEND_IMAGE = "${env.ECR_REGISTRY}/blockverse-frontend:${env.IMAGE_TAG}"

                    sshagent(credentials: [env.K3S_SSH_CREDENTIALS_ID]) {
                        // Step 1: Refresh ECR credentials on the server
                        sh "ssh -o StrictHostKeyChecking=no ${REMOTE} 'sudo /usr/local/bin/ecr-login.sh'"

                        // Step 2: Rolling update — update the container image
                        sh "ssh ${REMOTE} '${KUBECTL} set image deployment/blockverse-backend  backend=${BACKEND_IMAGE}  -n ${env.K8S_NAMESPACE}'"
                        sh "ssh ${REMOTE} '${KUBECTL} set image deployment/blockverse-frontend frontend=${FRONTEND_IMAGE} -n ${env.K8S_NAMESPACE}'"

                        // Step 3: Wait for rollout to complete
                        sh "ssh ${REMOTE} '${KUBECTL} rollout status deployment/blockverse-backend  -n ${env.K8S_NAMESPACE} --timeout=120s'"
                        sh "ssh ${REMOTE} '${KUBECTL} rollout status deployment/blockverse-frontend -n ${env.K8S_NAMESPACE} --timeout=120s'"
                    }
                }
            }
        }

    }

    post {
        success {
            echo "SUCCESS: BlockVerse deployed. Tag: ${env.IMAGE_TAG}"
        }
        failure {
            echo "FAILURE: Deployment failed. Check logs above."
        }
    }
}
