# ─────────────────────────────────────────────────────────────────────────────
#  BlockVerse — Environment Variables (copy to .env and fill in secrets)
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports (change if defaults collide on your machine) ──────────────────────
MYSQL_PORT=3306
REDIS_PORT=6379
ZOOKEEPER_PORT=2181
KAFKA_EXTERNAL_PORT=9092
BACKEND_PORT=8080
FRONTEND_PORT=3000
KAFKA_UI_PORT=8090
REDIS_COMMANDER_PORT=8085

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme_root
DB_NAME=blockverse
DB_USER=blockverse
DB_PASS=changeme_app

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis

# ── JWT (use a long random base64 string in production) ──────────────────────
JWT_SECRET=changeme_replace_with_a_very_long_random_secret_value_at_least_512bits

# ── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ── Frontend public URLs ──────────────────────────────────────────────────────
# When running inside Docker, backend is reached via service name "backend"
# When exposing to the browser (client-side), use your host/IP or domain
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# ── Spring profile ───────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Tooling (Kafka UI & Redis Commander) ─────────────────────────────────────
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASS=changeme_admin
